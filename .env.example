# Telegram（从 my.telegram.org 获取）
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890
SESSION_NAME=mili
SESSIONS_DIR=sessions

# 运行产物目录（JSON/CSV/日志）
DATA_DIR=data
LOGS_DIR=logs

# AI Provider: openai 或 gemini
AI_PROVIDER=openai

# 通用 AI 参数
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_SECONDS=1
AI_CONFIRM_TIMEOUT_SECONDS=120
AI_BATCH_SIZE=40
AI_CONCURRENCY=2

# 推理强度参数；不兼容的端点会自动降级重试
OPENAI_REASONING_EFFORT=high
OPENAI_VERBOSITY=medium
GEMINI_THINKING_BUDGET=2048
GEMINI_INCLUDE_THOUGHTS=false

# Telegram 扫描参数
TELEGRAM_RECENT_MESSAGE_LIMIT=0
TELEGRAM_CHANNEL_RECENT_MESSAGE_LIMIT=1
TELEGRAM_SCAN_DELAY_SECONDS=0.3
TELEGRAM_SCAN_CONCURRENCY=3
TELEGRAM_FETCH_FULL_INFO=false
TELEGRAM_CACHE_SAVE_EVERY=10

# OpenAI 配置
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45

# Gemini 配置
GEMINI_API_KEY=AIzaSyxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=45
